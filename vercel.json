{
  "rewrites": [
    {
      "source": "/secrets.js",
      "destination": "/api/secrets"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.prjgenuiworkforce.co.uk"
        }
      ],
      "destination": "https://prjgenuiworkforce.co.uk/:path*",
      "permanent": true
    },
    {
      "source": "/services.html",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/how-it-works.html",
      "destination": "/#how-it-works",
      "permanent": true
    },
    {
      "source": "/coverage.html",
      "destination": "/#coverage",
      "permanent": true
    },
    {
      "source": "/compare.html",
      "destination": "/#ask",
      "permanent": true
    },
    {
      "source": "/faq.html",
      "destination": "/#faq",
      "permanent": true
    }
  ]
}
